{
  "name": "myapp",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "test": {
      "name": "myapp-test"
    },
    "production": {
      "name": "myapp"
    }
  }
}
